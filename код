# archflux-run.ps1
# Надёжный скрипт: обновить репозиторий, собрать ISO и запустить VirtualBox.
# Сохраняйте в каталоге по желанию и запускайте в PowerShell.

param(
    [string]$RepoPath = "$env:USERPROFILE\Documents\DAppCrypto.github.io\arch",
    [string]$VMName   = "ArchFluxOS",
    [int]$MemoryMB    = 2048,
    [int]$CPUs        = 2,
    [int]$VRAM        = 16,
    [int]$DiskSizeMB  = 20000, # 20 GB
    [string]$WorkDir   = "work"
)

function Write-Info($msg) { Write-Host "==> $msg" -ForegroundColor Cyan }
function Write-Warn($msg) { Write-Host "==> $msg" -ForegroundColor Yellow }
function Write-Err($msg)  { Write-Host "❌ $msg" -ForegroundColor Red }

Write-Info "Проверяю наличие зависимостей..."

$gitCmd = Get-Command git -ErrorAction SilentlyContinue
$vboxCmd = Get-Command VBoxManage -ErrorAction SilentlyContinue
$bashCmd = Get-Command bash -ErrorAction SilentlyContinue
$wslCmd  = Get-Command wsl -ErrorAction SilentlyContinue

if (-not $gitCmd) { Write-Err "git не найден в PATH. Установите git или добавьте его в PATH."; exit 1 }
if (-not $vboxCmd) { Write-Err "VBoxManage (VirtualBox) не найден в PATH. Установите VirtualBox или добавьте VBoxManage в PATH."; exit 1 }
if (-not $bashCmd -and -not $wslCmd) {
    Write-Warn "Не найден bash и wsl. Для запуска build.sh потребуется bash (Git Bash) или WSL."
    # не выходим, всё ещё можно продолжить, если сборка не требуется
}

# Нормализуем пути
$RepoPath = (Resolve-Path -Path $RepoPath).Path
Set-Location -Path $RepoPath

Write-Info "Рабочий каталог: $RepoPath"

# Обновляем репозиторий и submodules
try {
    Write-Info "Обновляю репозиторий и submodules..."
    git pull --recurse-submodules
    git submodule update --init --recursive
} catch {
    Write-Err "Ошибка при обновлении git: $_"
    exit 1
}

# Запуск сборки ISO
$buildScript = Join-Path $RepoPath "scripts\build.sh"
if (Test-Path $buildScript) {
    Write-Info "Найден build script: $buildScript. Запускаю сборку ISO..."
    try {
        if ($bashCmd) {
            & bash $buildScript
        } elseif ($wslCmd) {
            # если WSL, запустим через wsl; путь Windows -> WSL путь может потребовать преобразования,
            # но часто wsl bash -lc "cd /mnt/c/..." — проще вызвать directly, если репозиторий в WSL.
            Write-Warn "Запуск через wsl; убедитесь, что репозиторий доступен внутри WSL."
            & wsl bash -lc "/mnt/$(($RepoPath -replace '^[A-Za-z]','').ToCharArray()[0])/$(($RepoPath -replace '^[A-Za-z]:\\','') -replace '\\','/')/scripts/build.sh" 2>$null
        } else {
            Write-Warn "bash/wsl не найден. Пропускаю запуск сборки. Убедитесь, что ISO уже создан."
        }
    } catch {
        Write-Err "Ошибка при запуске сборки: $_"
        # Не обязательно выходить, может быть уже собран ISO
    }
} else {
    Write-Warn "Скрипт сборки не найден: $buildScript. Пропускаю сборку."
}

# Ищем ISO
$isoPathDefault = Join-Path $RepoPath (Join-Path $WorkDir "ArchFlux-OS.iso")
if (Test-Path $isoPathDefault) {
    $isoPath = $isoPathDefault
} else {
    Write-Warn "ISO по ожидаемому пути не найден: $isoPathDefault. Попробую найти любой *.iso в каталоге '$WorkDir'..."
    $isos = Get-ChildItem -Path (Join-Path $RepoPath $WorkDir) -Filter *.iso -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending
    if ($isos -and $isos.Count -gt 0) {
        $isoPath = $isos[0].FullName
        Write-Info "Найден ISO: $isoPath"
    } else {
        Write-Err "ISO не найден в $($RepoPath)\$WorkDir. Убедитесь, что сборка прошла успешно."
        exit 1
    }
}

# Проверим существование VM
$vmExists = $false
try {
    & VBoxManage showvminfo $VMName > $null 2>&1
    if ($LASTEXITCODE -eq 0) { $vmExists = $true }
} catch { $vmExists = $false }

if ($vmExists) {
    Write-Warn "Виртуальная машина '$VMName' уже существует."
    $choice = Read-Host "Введите 'r' чтобы удалить и пересоздать VM, 'k' чтобы использовать существующую (и перезаписать контроллеры/диски), или Enter чтобы отменить"
    if ($choice -eq 'r') {
        Write-Info "Останавливаю и удаляю существующую VM '$VMName'..."
        try {
            & VBoxManage controlvm $VMName poweroff 2>$null
        } catch {}
        & VBoxManage unregistervm $VMName --delete
        $vmExists = $false
    } elseif ($choice -eq 'k') {
        Write-Info "Буду использовать существующую VM '$VMName' и попробую обновить привязки дисков/ISO."
    } else {
        Write-Info "Отмена."
        exit 0
    }
}

if (-not $vmExists) {
    Write-Info "Создаю VM '$VMName'..."
    & VBoxManage createvm --name $VMName --register --ostype "Linux_64" | Out-Null
    & VBoxManage modifyvm $VMName --memory $MemoryMB --cpus $CPUs --vram $VRAM --graphicscontroller vmsvga --audio none
}

# Настроим контроллер SATA и диск
$sataName = "SATA Controller"
# Проверим, есть ли уже контроллер с таким именем
$hasController = & VBoxManage showvminfo $VMName --machinereadable | Select-String -Pattern "storagecontrollername" | Select-String -Pattern $sataName

if (-not $hasController) {
    Write-Info "Добавляю контроллер SATA..."
    & VBoxManage storagectl $VMName --name $sataName --add sata --controller IntelAhci
}

# Создаём файл диска в корне репозитория (если ещё нет)
$vdiPath = Join-Path $RepoPath "$VMName.vdi"
if (-not (Test-Path $vdiPath)) {
    Write-Info "Создаю виртуальный диск $vdiPath (${DiskSizeMB}MB)..."
    & VBoxManage createmedium disk --filename $vdiPath --size $DiskSizeMB --format VDI | Out-Null
} else {
    Write-Info "Виртуальный диск найден: $vdiPath"
}

# Присоединяем диск (порт 0)
Write-Info "Присоединяю виртуальный диск к SATA порту 0..."
& VBoxManage storageattach $VMName --storagectl $sataName --port 0 --device 0 --type hdd --medium $vdiPath

# Присоединяем ISO как DVD (порт 1)
Write-Info "Присоединяю ISO ($isoPath) как DVD..."
& VBoxManage storageattach $VMName --storagectl $sataName --port 1 --device 0 --type dvddrive --medium $isoPath

# Опционально: включим EFI, если нужно (раскомментируйте)
# & VBoxManage modifyvm $VMName --firmware efi

Write-Info "Запускаю VM '$VMName'..."
try {
    & VBoxManage startvm $VMName
    Write-Info "VM запущена. Ожидайте окно VirtualBox."
} catch {
    Write-Err "Не удалось запустить VM: $_"
    exit 1
}
