general {
  colors = true
  interval = 5
}
order += "wireless _first_"
order += "ethernet _first_"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
  format_up = "W: %essid (%quality)"
  format_down = "W: down"
}
ethernet _first_ {
  format_up = "E: %ip"
  format_down = "E: down"
}
load { format = "L: %1min" }
memory { format = "M: %used/%total" }
tztime local { format = "%Y-%m-%d %H:%M" }
